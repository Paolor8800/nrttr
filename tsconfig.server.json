{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "outDir": "./server-dist",
    "rootDir": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "types": ["node"]
  },
  "include": [
    "server/**/*.ts",
    "src/data/**/*.ts",
    "src/lib/casinoRoulette.ts",
    "src/lib/cardDeck.ts",
    "src/lib/roomCode.ts",
    "src/lib/roomLimits.ts"
  ]
}
